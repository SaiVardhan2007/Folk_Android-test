{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret settings. Secrets (ERPNEXT_API_KEY, ERPNEXT_API_SECRET, JWT_SECRET, WHATSAPP_API_KEY, MSG91_AUTH_KEY, MSG91_OTP_TEMPLATE_ID) are set with `wrangler secret put`.
  "vars": {
    "ERPNEXT_URL": "https://erp.hkmh.in",
    "MAIN_ADMIN_MOB": "9133318576",
    "WHATSAPP_URL": "https://kycapi.finanalyz.com/api/send-template-message",
    "WHATSAPP_PHONE_NUMBER_ID": "598435813347675",
    "WELCOME_VENUE": "Hare Krishna Heritage Tower",
    "WELCOME_MAP_LINK": "https://maps.app.goo.gl/qFhNCt7eRw2ez6mT8",
    "DEFAULT_GUIDE_MOB": "9390927165",
    // Set to "1" only after MSG91_OTP_TEMPLATE_ID points to a DLT template that ends with ##hash## (see docs/RELEASING.md).
    "OTP_SMS_HAS_APP_HASH": "0"
  },
  "keep_vars": true,
  // The shared receipt print queue (src/printHub.ts). SQLite-backed so it also works on the free plan.
  "durable_objects": { "bindings": [{ "name": "PRINT_HUB", "class_name": "PrintHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrintHub"] }],
  // Brute-force protection for login/sign-up (per IP, shared across all Cloudflare locations).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Public registration pages: lookups and submissions per IP (stops number-guessing and spam).
    { "name": "PUBLIC_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
