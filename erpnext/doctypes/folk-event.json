{
  "doctype": "DocType",
  "name": "FOLK Event",
  "module": "Custom",
  "custom": 1,
  "naming_rule": "By fieldname",
  "autoname": "field:code",
  "title_field": "event_name",
  "show_title_field_in_link": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "code",
      "label": "Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Short unique code, e.g. SUNDAY01 or CAMP2026. Cannot be changed later."
    },
    {
      "fieldname": "event_name",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "report": 1
    }
  ]
}
