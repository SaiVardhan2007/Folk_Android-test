{
  "doctype": "DocType",
  "name": "FOLK Users",
  "module": "Custom",
  "custom": 1,
  "naming_rule": "By fieldname",
  "autoname": "field:mob_no",
  "title_field": "full_name",
  "search_fields": "full_name,mob_no",
  "show_title_field_in_link": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "mob_no",
      "label": "Mobile No",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "10 digits, no +91. This is the record's ID."
    },
    {
      "fieldname": "full_name",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "gender",
      "label": "Gender",
      "fieldtype": "Select",
      "options": "\nM\nF"
    },
    {
      "fieldname": "level",
      "label": "Level",
      "fieldtype": "Select",
      "options": "\nFolk Foundation\nFolk Prelims",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "pg_name",
      "label": "PG / Residence",
      "fieldtype": "Data"
    },
    {
      "fieldname": "profession",
      "label": "Profession / Company / College",
      "fieldtype": "Data"
    },
    {
      "fieldname": "event_code",
      "label": "Event",
      "fieldtype": "Link",
      "options": "FOLK Event",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "attendance_count",
      "label": "Attendance Count",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1,
      "in_list_view": 1,
      "description": "Total check-ins. Updated by the app."
    },
    {
      "fieldname": "last_attended_on",
      "label": "Last Attended On",
      "fieldtype": "Date",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "registered_by",
      "label": "Registered By",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "user_tag",
      "label": "User Tag",
      "fieldtype": "Select",
      "options": "People\nCoordinator\nAdmin",
      "default": "People",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Everyone starts as People. Only an Admin changes it, from the Admin page in the app."
    },
    {
      "fieldname": "password_hash",
      "label": "Password Hash",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1,
      "description": "PBKDF2 hash written by the app. Never a plain password."
    },
    {
      "fieldname": "attendance_section",
      "label": "Attendance",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "attendance",
      "label": "Attendance",
      "fieldtype": "Table",
      "options": "FOLK Users Attendance",
      "description": "One row per event per day. Added by the app; use Undo in the app to remove one."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "report": 1
    }
  ]
}